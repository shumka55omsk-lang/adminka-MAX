MAX_BOT_TOKEN=your_max_bot_token
ADMIN_PASSWORD=change_me
MAX_API_BASE_URL=https://platform-api.max.ru
MAX_TLS_MODE=default

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

PUBLIC_BASE_URL=https://adminka-max.vercel.app
MINIAPP_PUBLIC_URL=https://www.zamer55.ru/miniapp
MAX_WEBHOOK_SECRET=max-secret-12345
CRON_SECRET=max-cron-secret-12345

# Куда бот будет присылать новые заявки из мини-приложения.
# Это может быть chat_id служебной группы MAX “Заявки MAX”.
MAX_NOTIFY_CHAT_ID=

# Для теста вне MAX оставь true. После проверки внутри MAX можно поставить false.
MINIAPP_ALLOW_UNVERIFIED=true
MINIAPP_REQUIRE_FRESH_AUTH=false
MINIAPP_AUTH_MAX_AGE_SECONDS=3600

# Если true, заявка дополнительно попадёт в таблицу max_crm_leads.
CRM_INTEGRATION_ENABLED=false

# v23: Яндекс Директ / Метрика / аудитории + мягкое согласие
YANDEX_METRIKA_COUNTER_ID=
PRIVACY_POLICY_URL=https://example.com/privacy
MINIAPP_CONSENT_TEXT=Согласен(на) на обработку персональных данных для расчёта и связи по заявке.

# v36: как формировать кнопки mini app в рекламных постах:
# short_link — короткие ссылки https://www.zamer55.ru/z и /s, меньше пугают на iPhone.
# open_app — экспериментальный режим кнопки MAX open_app, включать только если mini app подключён к боту в MAX.
MINIAPP_BUTTON_TYPE=short_link
MAX_OPEN_APP_WEB_APP=id550507026940_bot

# v39: заявки "Знаю размеры" дополнительно пишутся напрямую в CRM мягких окон:
# clients + calculations + client_history. Можно выключить прямую запись, оставив очередь max_crm_leads.
CRM_LEGACY_DIRECT_ENABLED=true

# Dedicated Supabase database used by the existing soft-windows CRM.
# Copy these two values from the Vercel project where CRM мягкие окна already works.
CRM_SUPABASE_URL=https://your-crm-project.supabase.co
CRM_SUPABASE_SERVICE_ROLE_KEY=your_crm_service_role_key
CRM_REQUIRE_DEDICATED_SUPABASE=true
CRM_INTEGRATION_ENABLED=true
CRM_LEGACY_DIRECT_ENABLED=true
